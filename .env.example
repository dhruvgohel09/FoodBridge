# Food Bridge Environment Configuration Template
# Copy this file to .env and configure your local credentials

MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-digit-google-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Food Bridge Official Team"
MAIL_REPLY_TO=your-email@gmail.com
